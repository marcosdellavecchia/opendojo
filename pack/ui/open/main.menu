// written for the open pack
{
	assetGlobalDef
	{
		font "open_medium" 20
		smallFont "open_small" 18
		bigFont "open_large" 20
		cursor "ui/open/cursor"
		stripedFile "menus0"
		stripedFile "menus3"
		fadeClamp 1.0
		fadeCycle 1
		fadeAmount 0.1
		shadowColor 0.1 0.1 0.1 0.25
	}
	menuDef
	{
		name "main"
		fullScreen 1
		rect 0 0 640 480
		visible 1
		focusColor 0.4 0.7 1 1
		style WINDOW_STYLE_FILLED
		backcolor 0.03 0.04 0.06 1
		itemDef
		{
			name "title"
			text "Open Dojo"
			style WINDOW_STYLE_EMPTY
			rect 0 160 640 40
			forecolor 1 1 1 1
			font 3
			textscale 1.2
			textalign ITEM_ALIGN_CENTER
			textalignx 320
			visible 1
			decoration
		}
		itemDef
		{
			name "play"
			text "Reconnect"
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_FILLED
			rect 220 240 200 32
			backcolor 0.12 0.15 0.2 0.9
			forecolor 0.9 0.93 1 1
			font 2
			textscale 1
			textalign ITEM_ALIGN_CENTER
			textalignx 100
			textaligny 4
			visible 1
			mouseEnter { setitemcolor "play" backcolor 0.2 0.45 0.8 1 }
			mouseExit { setitemcolor "play" backcolor 0.12 0.15 0.2 0.9 }
			action { exec "reconnect" }
		}
		itemDef
		{
			name "quit"
			text "Quit"
			type ITEM_TYPE_BUTTON
			style WINDOW_STYLE_FILLED
			rect 220 284 200 32
			backcolor 0.12 0.15 0.2 0.9
			forecolor 0.9 0.93 1 1
			font 2
			textscale 1
			textalign ITEM_ALIGN_CENTER
			textalignx 100
			textaligny 4
			visible 1
			mouseEnter { setitemcolor "quit" backcolor 0.2 0.45 0.8 1 }
			mouseExit { setitemcolor "quit" backcolor 0.12 0.15 0.2 0.9 }
			action { uiScript Quit }
		}
	}
}
